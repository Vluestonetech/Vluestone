---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Serviços - Vluestone" activePage="service">
    <div slot="header">
        <div class="container-fluid bg-primary py-5 bg-header" style="margin-bottom: 90px;">
            <div class="row py-5">
                <div class="col-12 pt-lg-5 mt-lg-5 text-center">
                    <h1 class="display-4 text-white animated zoomIn">Serviços</h1>
                </div>
            </div>
        </div>
    </div>

    <!-- Service Start -->
    <div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="section-title text-center position-relative pb-3 mb-5 mx-auto" style="max-width: 600px;">
                <h5 class="fw-bold text-primary text-uppercase">Nossas Soluções de TI</h5>
                <h1 class="mb-0">Para o seu negócio</h1>
            </div>
            <div class="row g-5">
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.3s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="service-icon">
                            <i class="fa fa-shield-alt text-white"></i>
                        </div>
                        <h4 class="mb-3">Landing pages</h4>
                        <p class="m-0">As landing pages são páginas de destino focadas em uma única ação.</p>
                        <a class="btn btn-lg btn-primary rounded" href="/landing-pages">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.6s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="service-icon">
                            <i class="fa fa-chart-pie text-white"></i>
                        </div>
                        <h4 class="mb-3">E-commerce</h4>
                        <p class="m-0">Capacidade para alcançar clientes em potencial em todo o mundo e mostrar seus produtos.</p>
                        <a class="btn btn-lg btn-primary rounded" href="/ecommerce">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.9s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="service-icon">
                            <i class="fa fa-code text-white"></i>
                        </div>
                        <h4 class="mb-3">Sites Institucionais</h4>
                        <p class="m-0">Importante para uma empresa ou profissional, por ser um canal de comunicação.</p>
                        <a class="btn btn-lg btn-primary rounded" href="/sites-institucionais">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.3s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="service-icon">
                            <i class="fab fa-android text-white"></i>
                        </div>
                        <h4 class="mb-3">App</h4>
                        <p class="m-0">Busca facilitar a realização de tarefas e proporcionar entretenimento aos usuários. </p>
                        <a class="btn btn-lg btn-primary rounded" href="/aplicativos">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.6s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="service-icon">
                            <i class="fa fa-search text-white"></i>
                        </div>
                        <h4 class="mb-3">Manutenção</h4>
                        <p class="m-0"> Visa garantir a eficiência e confiabilidade dos sistemas de uma empresa, antecipando e prevenindo problemas</p>
                        <a class="btn btn-lg btn-primary rounded" href="/manutencao">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.9s">
                    <div class="position-relative bg-primary rounded h-100 d-flex flex-column align-items-center justify-content-center text-center p-5">
                        <h3 class="text-white mb-3">Nossa virtude</h3>
                        <p class="text-white mb-3">"Não existe excelência sem qualidade, e qualidade é a essência de um serviço bem feito."</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Service End -->

    <!-- Vendor Start -->
    <div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5 mb-5">
            <div class="bg-white">
                <div class="owl-carousel vendor-carousel">
                    <img src="/img/vendor-1.jpg" alt="">
                    <img src="/img/vendor-2.jpg" alt="">
                    <img src="/img/vendor-3.jpg" alt="">
                    <img src="/img/vendor-4.jpg" alt="">
                    <img src="/img/vendor-5.jpg" alt="">
                    <img src="/img/vendor-6.jpg" alt="">
                    <img src="/img/vendor-7.jpg" alt="">
                    <img src="/img/vendor-8.jpg" alt="">
                    <img src="/img/vendor-9.jpg" alt="">
                </div>
            </div>
        </div>
    </div>
    <!-- Vendor End -->
</MainLayout>
